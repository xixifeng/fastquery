{

  "scope":[
    {
        "config": "hikari",           // 连接池的提供者.如: hikari, c3p0, druid
        "dataSourceName": "xkdb2",    // 数据源的名称
        "basePackages": [             // 该数据源的作用范围
            "org.fastquery.example",              // 包地址
            "org.fastquery.dao.UserInfoDBService",// 完整类名称
            "org.fastquery.dao.QueryByNamedDBExample",
            "org.fastquery.dao.QueryByNamedDBExtend",
            "org.fastquery.dao.SQLInExample",
            "org.fastquery.dao.ProcedureExample",
            "org.fastquery.dao.ProductDBService",
            "org.fastquery.dao.ConditionDBService",
            "org.fastquery.dao.TypeFeatureDBService",
            "org.fastquery.dao.SetDBService"
            // 在这可以配置多个DB接口或包地址,以","号隔开
        ]
    }
    ,
    {
        "config": "mySQLDriver",  
        "dataSourceName": "world-mysql",
        
         // or
         //"config": "sqlServerDriver",
         //"dataSourceName": "world",
         
         // or
         //"config": "postgreSQLDriver",
         //"dataSourceName": "world-pgsql",
        
        "basePackages": ["org.fastquery.sqlserver.dao"]
    }
    ,
    {
        "config": "c3p0",            
        "dataSourceName": "sunnydb", 
        "basePackages": [            
            "org.fastquery.dao.SunnyDBService"
        ]
    }
    ,
    {
        "config": "c3p0",            // 表示由c3p0负责提供数据源
        "basePackages": [   
             "org.fastquery.dao2.UserInfoDB"
        ]
    }
    
    ,
    {
        "config": "mySQLDriver",            // 表示由jdbc负责提供数据源
        "dataSourceName": "xk3",     // 数据源的名称
        "basePackages": [   
             "org.fastquery.dao2.UserInfoDBRepository",
             "org.fastquery.dao2.DefaultDBService"
        ]
    }
    
    ,
    {
        "config": "mySQLDriver",           
        "dataSourceName": "s1", 
        "basePackages": [   
             "org.fastquery.db"
        ]
    }
    
    ,
    {
        "config": "mySQLDriver",           
        "dataSourceName": "s2", 
        "basePackages": [   
             "org.fastquery.dbm"
        ]
    }
    
    ,
    {
        "config": "mySQLDriver"
    }
    
    ,
    {
        "config": "mySQLDriver",           
        "dataSourceName": "s3"
    }
    
    ,
    {
        "config": "druid",            
        "dataSourceName": "aa", 
        "basePackages": [ "org.fastquery.db2.AA"]
    }
    
     ,
    {
        "config": "c3p0",            
        "dataSourceName": "bb", 
        "basePackages": [ "org.fastquery.db2.BB"]
    }
    
    ,
    {
        "config": "mySQLDriver",            
        "dataSourceName": "cc", 
        "basePackages": [ "org.fastquery.db2.CC"]
    }
    
 ],
 
  // 基准目录,注意: 后面记得加上 "/"
 "basedir" : "/Users/mei.sir/workspace/fastquery/src/test/resources/testFiles/",

  // 在调试模式下,可以动态装载xml里的SQL语句,且不用重启项目,默认是false,表示不开启调试模式.提醒:在生产阶段不要开启该模式
  "debug" : false,
 
  // 指定*.queries.xml(SQL模板文件)可以放在classpath目录下的哪些文件夹下.默认:允许放在classpath根目录下
  "queries": ["queries/","tpl/"] // 表示: SQL模板文件可以放在classpath/queries里 或 classpath/tpl里
  
  ,"slowQueryTime": 50 // 单位毫秒: 记录慢查询,超过这个时间,就打印警告日志

  ,"convert" : [
      {
        "sourceType" : "java.lang.Integer",
        "targetType" : "org.fastquery.bean.Option",
        "converter"  : "org.fastquery.bean.IntToOptionConverter"
      }
   ]
}
